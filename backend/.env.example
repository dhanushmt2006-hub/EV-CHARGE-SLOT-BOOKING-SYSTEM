PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/voltslot?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
PAYMENT_MODE=demo
# Razorpay is optional and is never used when PAYMENT_MODE=demo.
# To enable the separate Razorpay Test Mode provider, set PAYMENT_MODE=razorpay
# and provide your own credentials locally (never commit them):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
